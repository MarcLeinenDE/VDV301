{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcLeinenDE/VDV301/sdk_manifest/known_issues_runtime_mapping_v0.1.schema.json",
  "title": "VDV 301 Known-Issues Runtime Mapping Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "kind",
    "state",
    "source_semantic_registry",
    "source_frozen_baseline",
    "policy",
    "counts",
    "mappings"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "known-issues-runtime-mapping"
    },
    "state": {
      "enum": [
        "reviewed_inventory",
        "implementation_in_progress",
        "implemented"
      ]
    },
    "source_semantic_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob",
        "classification_state",
        "finding_count"
      ],
      "properties": {
        "path": {
          "const": "audit_registry/finding_semantic_classification_v0.1.json"
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "classification_state": {
          "const": "complete"
        },
        "finding_count": {
          "const": 192
        }
      }
    },
    "source_frozen_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "baseline_payload_sha256"
      ],
      "properties": {
        "path": {
          "const": "audit_registry/finding_provenance_baseline_2026-09-14.json"
        },
        "baseline_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_xsd_result_must_not_be_overridden",
        "generated_only_from_runtime_match_reviewed",
        "trigger_descriptions_are_not_executable_matchers",
        "implementation_requires_separate_profile_specific_validation"
      ],
      "properties": {
        "normative_xsd_result_must_not_be_overridden": {
          "const": true
        },
        "generated_only_from_runtime_match_reviewed": {
          "const": true
        },
        "trigger_descriptions_are_not_executable_matchers": {
          "const": true
        },
        "implementation_requires_separate_profile_specific_validation": {
          "const": true
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_mapping_count",
        "implemented_count",
        "semantic_candidate_count",
        "semantic_not_designed_count",
        "semantic_not_applicable_count"
      ],
      "properties": {
        "reviewed_mapping_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        },
        "implemented_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        },
        "semantic_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        },
        "semantic_not_designed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        },
        "semantic_not_applicable_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        }
      }
    },
    "mappings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "service",
          "semantic_issue_kind",
          "sdk_behavior",
          "activation_class",
          "required_precondition",
          "result_effect",
          "implementation_state",
          "authority_guard",
          "profile_scope",
          "trigger_descriptions",
          "diagnostic_source"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "semantic_issue_kind": {
            "type": "string",
            "minLength": 1
          },
          "sdk_behavior": {
            "enum": [
              "error_with_advisory",
              "valid_with_advisory",
              "warning",
              "info",
              "unsupported_profile",
              "no_runtime_diagnostic"
            ]
          },
          "activation_class": {
            "enum": [
              "profile_resolution_failure",
              "xsd_invalid_advisory",
              "xsd_valid_advisory",
              "resolver_or_profile_warning",
              "routing_only",
              "informational"
            ]
          },
          "required_precondition": {
            "enum": [
              "strict_profile_resolution_failed",
              "xsd_result_invalid",
              "xsd_result_valid",
              "resolver_context_matched",
              "routing_context_matched",
              "informational_context_matched"
            ]
          },
          "result_effect": {
            "enum": [
              "emit_unsupported_profile",
              "decorate_existing_invalid",
              "decorate_existing_valid",
              "emit_warning",
              "routing_only_no_public_diagnostic",
              "emit_info"
            ]
          },
          "implementation_state": {
            "enum": [
              "reviewed_not_implemented",
              "implemented"
            ]
          },
          "authority_guard": {
            "const": "selected_xsd_result_remains_normative"
          },
          "profile_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "authority"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "authority": {
                  "enum": [
                    "official_release",
                    "candidate_integration",
                    "documentation_only",
                    "unresolved"
                  ]
                },
                "xsd_profile": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "trigger_descriptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "diagnostic_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registry",
              "finding_id"
            ],
            "properties": {
              "registry": {
                "const": "audit_registry/finding_semantic_classification_v0.1.json"
              },
              "finding_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
